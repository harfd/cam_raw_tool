  "decision": {
    "scene": "户外林间水岸写生场景，古树环绕，石桥横跨溪流，画面中有人静坐作画",
    "subject": "背对镜头写生的画家与画架上的风景画板，人物占比较小，画板是视觉焦点之一",
    "composition": "以人物与画架为右下方前景重点，大树干在右侧形成竖向框线，石桥与水面构成横向层次，远处植被与天空形成背景；整体构图自然，留白较多，画板与实景形成呼应",
    "lighting": "阴天柔光，光线漫射均匀，没有强烈直射光；天空较亮，树荫与水面较暗，暗部占比较大，整体对比中等偏低",
    "mood": "安静、沉浸、带一点阴天林间的静谧与潮湿感，适合表现写生现场的专注氛围",
    "recommended_style": "cinematic",
    "strategies": [
      "protect_highlights",
      "lift_shadows",
      "preserve_skin",
      "soften_contrast",
      "enhance_depth",
      "restrain_color"
    ],
    "rationale": "画面是高动态范围阴天场景：天空与局部亮点容易过曝，人物与树荫暗部较深，若统一大幅提亮会破坏真实树荫光影。计划采用轻提暗部、保护天空高光、局部提亮人物与画板的方案，保留现场明暗关系。同时绿色植被面积大，需控制绿色饱和度与明度，避免发灰或过艳；人物区域适度提亮并保护肤色与衣物质感。整体呈现电影感低饱和、暗部偏青灰、高光偏暖的中性层次，色调克制而自然。",
    "crop_suggestion": "保留原构图。若需要更突出画板与人物，可轻微裁掉最左侧水面和底部地面边缘，但不建议裁切右侧树干，以免削弱场景空间感。",

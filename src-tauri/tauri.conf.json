{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI RAW Studio",
  "version": "0.5.0",
  "identifier": "com.rawstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run frontend:dev",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist/ui",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AI RAW Studio",
        "width": 1440,
        "height": 960,
        "minWidth": 1000,
        "minHeight": 740,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../dist/raw-studio-server/": "server/"
    },
    "shortDescription": "本地优先的 AI RAW 摄影后期助手",
    "category": "Photography",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
